# Base de datos (PostgreSQL). Para desarrollo local sin Postgres: sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db
# Firma del JWT (mínimo 32 caracteres)
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Origen permitido en CORS (frontend)
FRONTEND_ORIGIN=http://localhost:5173
